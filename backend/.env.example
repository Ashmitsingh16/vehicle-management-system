PORT=5000

# MongoDB — use Atlas URI in production
MONGO_URI=mongodb+srv://USERNAME:PASSWORD@cluster0.xxxxx.mongodb.net/vehicle_emergency_db?retryWrites=true&w=majority

# JWT
JWT_SECRET=your_very_strong_secret_key_here
JWT_EXPIRE=7d
NODE_ENV=production

# CORS — comma-separated list of allowed frontend origins
CORS_ORIGIN=https://your-frontend.netlify.app

# Gmail API (OAuth credentials; SMTP settings are not used)
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_USER=
FRONTEND_URL=https://your-frontend.netlify.app

# Transactions require MongoDB Atlas or a replica set (not standalone MongoDB).
# Set only to the exact number of trusted reverse proxies in front of this API.
TRUST_PROXY_HOPS=0
